# E2E Test Automation Environment Credentials
NODE_ENV=test

# Backend API Base URL (Port 3000 matching backend/.env)
E2E_API_URL=http://localhost:3000

# Frontend Base URL
E2E_BASE_URL=http://localhost:5173

# Superadmin Credentials
E2E_SUPERADMIN_EMAIL=e2e-superadmin@example.test
E2E_SUPERADMIN_PASSWORD=E2eSuperadmin-ChangeMe1!

# Admin Credentials
E2E_ADMIN_EMAIL=e2e-admin@example.test
E2E_ADMIN_PASSWORD=E2eAdmin-ChangeMe1!

# User Credentials
E2E_USER_EMAIL=e2e-user@example.test
E2E_USER_PASSWORD=E2eUser-ChangeMe1!

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=trackit_test
JWT_SECRET=replace-with-a-long-random-test-secret
