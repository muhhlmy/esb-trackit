datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Case {
  id               String            @id
  title            String
  category         String
  tags             Json              @default("[]")
  summary          String            @default("")
  problemContext   String            @default("") @map("problem_context")
  actionSteps      Json              @default("[]") @map("action_steps")
  dosAndDonts      Json              @default("{\"dos\":[],\"donts\":[]}") @map("dos_and_donts")
  snippets         Json              @default("[]")
  isCustom         Boolean           @default(false) @map("is_custom")
  isFeaturedOnHome Boolean           @default(false) @map("is_featured_on_home")
  homeOrder        Int               @default(0) @map("home_order")
  isPublished      Boolean           @default(true) @map("is_published")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  interactions     CaseInteraction[]

  @@map("cases")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String   @default("Admin")
  role      String   @default("admin")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model CaseInteraction {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  type      String   // "view" | "click" | "helpful" | "unhelpful"
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("case_interactions")
}
