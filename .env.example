# Docker Compose & Root Environment Configuration
# Copy to .env before running: docker compose up

# PostgreSQL Credentials (Wajib diisi & aman)
DB_USER=postgres
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!
DB_NAME=assets_monitoring
DB_PORT=5432

# Backend Security & JWT (Wajib diisi minimal 32 karakter acak)
JWT_SECRET=GantiDenganSecretAcakMinimal32KarakterYangKuatDanAman!
DEFAULT_USER_PASSWORD=TemporaryUserPass123!

# Host & Ports
PORT=3000
