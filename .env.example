# Docker Compose & Root Environment Configuration
# Copy to .env before running: docker compose up

# PostgreSQL Credentials (Wajib diisi & aman)
DB_USER=postgres
DB_PASSWORD=
DB_NAME=esb_trackit
DB_PORT=5432

# Backend Security & JWT (Wajib diisi minimal 32 karakter acak)
JWT_SECRET=

# Host & Ports
PORT=3000

# Public application origin (HTTPS origin for production behind TLS termination)
CORS_ORIGINS=http://localhost

# Trusted Reverse Proxy CIDRs
# Dalam topology Docker Compose default, subnet jaringan internal Nginx adalah 172.28.0.0/16.
# Jika menggunakan reverse proxy host atau external load balancer (AWS ALB / Cloudflare / Nginx host),
# ganti dengan IP/CIDR exact proxy Anda (misal: 127.0.0.1/32 atau 10.0.0.0/16).
# PERINGATAN: Jangan gunakan wildcard (*), true, atau 0.0.0.0/0.
TRUST_PROXY_CIDRS=172.28.0.0/16

# ===================================================================
# DATABASE MIGRATION CONFIGURATION
# ===================================================================
# Mode migrasi: 'fresh' (database baru/kosong) atau 'existing' (database yang telah mengadopsi ledger).
MIGRATION_MODE=fresh
# Host database target yang harus cocok persis sebelum migration dijalankan
MIGRATION_EXPECTED_HOST=postgres
# Nama database target yang harus cocok persis sebelum migration dijalankan
MIGRATION_EXPECTED_DATABASE=esb_trackit
# Guard keamanan: wajib 'true' saat menjalankan npm run db:migrate:apply
ALLOW_DB_MIGRATIONS=false
# ID bukti verifikasi backup/restore sebelum menjalankan migrasi (minimal 8 karakter alphanumeric/punctuation)
MIGRATION_RECOVERY_PROOF_ID=
# Change request ticket / authorization ID (wajib diisi pada lingkungan production)
MIGRATION_CHANGE_ID=
# Wajibkan role pemilik database berstatus non-superuser (true/false)
REQUIRE_NON_SUPERUSER=false

# Required for account activation and password-reset email delivery
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FRONTEND_URL=http://localhost

# Hanya diperlukan bila reset database diaktifkan. Jangan gunakan kredensial
# contoh atau produksi yang sama pada environment berbeda.
ENABLE_DB_RESET=false
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# Backup/restore pada container memakai PostgreSQL client tools bawaan image.
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_MAX_FILES=20
