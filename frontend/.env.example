# ===================================================================
# TrackIT Frontend Environment Configuration
# ===================================================================
# Canonical Architecture: Same-Origin Deployment
# Biarkan VITE_API_BASE_URL kosong agar browser menggunakan same-origin cookies (HttpOnly session).
# - Development: Vite proxy otomatis meneruskan /api ke backend (port 3000).
# - Production: Nginx reverse proxy melayani SPA dan meneruskan /api ke backend container.
VITE_API_BASE_URL=

# Host/port development server (opsional)
VITE_HOST=127.0.0.1

# Explicit backend proxy target; frontend never reads backend/.env
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
# Comma-separated additional DNS hostnames for LAN development (no wildcard)
VITE_ALLOWED_HOSTS=

# ===================================================================
# AKUN AWAL / RESET DATABASE (KONFIGURASI BACKEND)
# ===================================================================
# Nama, email, dan password akun superadmin TIDAK boleh ditaruh dalam
# variabel VITE_ karena semua VITE_* akan dikirim ke browser saat build.
# Atur nilai berikut hanya di backend/.env. Backend akan memakainya ketika
# reset database diaktifkan (ENABLE_DB_RESET=true):
#
# SEED_SUPERADMIN_NAME=
# SEED_SUPERADMIN_EMAIL=
# SEED_SUPERADMIN_PASSWORD=
#
# Jangan menyimpan password asli di frontend/.env atau source code frontend.
