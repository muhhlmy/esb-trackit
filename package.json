{
  "name": "it-monitoring-assets-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace and E2E test runner for IT Monitoring Assets",
  "type": "module",
  "scripts": {
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e:prepare": "node scripts/initialize-test-database.mjs --seed-e2e",
    "test:e2e": "npm run test:e2e:prepare && playwright test",
    "test:e2e:headed": "npm run test:e2e:prepare && playwright test --headed",
    "test:e2e:ui": "npm run test:e2e:prepare && playwright test --ui",
    "test:e2e:smoke": "npm run test:e2e:prepare && playwright test --grep @smoke",
    "test:e2e:report": "playwright show-report",
    "docs:manual:pdf": "node scripts/generate-user-manual-pdf.mjs",
    "build:tokens": "node scripts/build-tokens.js",
    "deploy:frontend": "bash scripts/deploy-frontend.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.50.1"
  }
}
