PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Wajib diisi dengan password database deployment ini.
DB_PASSWORD=
DB_NAME=assets_monitoring
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Wajib diisi dengan secret acak minimal 32 karakter.
JWT_SECRET=
# Cost bcrypt untuk password baru/perubahan password (10-14; default 12).
PASSWORD_BCRYPT_ROUNDS=12
# Akun import/karyawan wajib aktivasi melalui OTP email, tanpa password bersama.
# Isi bila API berada di belakang reverse proxy tepercaya. Gunakan IP/CIDR
# exact yang dipisahkan koma; wildcard (*) dan hop-count generik ditolak.
# Contoh: 127.0.0.1/32 untuk proxy lokal, 172.28.0.0/16 untuk Docker Compose bridge network.
TRUST_PROXY_CIDRS=127.0.0.1/32
# Daftar origin exact, dipisahkan koma. Wildcard (*) ditolak.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===================================================================
# DATABASE MIGRATIONS (CANONICAL RUNNER)
# ===================================================================
# Mode: 'fresh' untuk database baru/kosong, 'existing' untuk database dengan ledger adopsi
MIGRATION_MODE=fresh
# Host target yang harus cocok persis sebelum migration dijalankan
MIGRATION_EXPECTED_HOST=localhost
# Nama database target yang harus cocok persis sebelum migration dijalankan
MIGRATION_EXPECTED_DATABASE=assets_monitoring
# Guard apply: wajib 'true' saat menjalankan npm run db:migrate:apply
ALLOW_DB_MIGRATIONS=false
# ID bukti verifikasi restore backup sebelum migrasi dijalankan
MIGRATION_RECOVERY_PROOF_ID=rec-proof-2026-09-09-init
# Change request ticket / authorization ID (wajib diisi pada target production)
MIGRATION_CHANGE_ID=CR-TRACKIT-2026-09-01
# Wajibkan database owner role non-superuser
REQUIRE_NON_SUPERUSER=false

# Konfigurasi Notifikasi Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="People Technology <people.technology@esb.co.id>"
FRONTEND_URL=http://localhost:5173

# ===================================================================
# SECURITY CONFIGURATIONS (NEW FOR PRODUCTION HARDENING)
# ===================================================================

# Superadmin seeding on DB reset
# Must be set to valid email + password (min 8 chars) for reset endpoint
# DO NOT commit real credentials to version control
SEED_SUPERADMIN_EMAIL=admin@company.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Administrator

# Enable/disable destructive database reset endpoint
# Default false; set true ONLY in development/testing environments
ENABLE_DB_RESET=false
