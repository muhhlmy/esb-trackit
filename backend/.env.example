# ============================================================================
# TrackIT Backend — Environment Configuration Template
# ============================================================================
# Salin file ini menjadi .env, lalu isi seluruh nilai yang ditandai WAJIB.
# Jangan pernah menyimpan .env, password, App Password, token, atau backup DB
# ke repository. Nilai contoh di bawah aman untuk dokumentasi, bukan produksi.

# ----------------------------------------------------------------------------
# APLIKASI & HTTP
# ----------------------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# URL aplikasi frontend untuk tautan dalam email notifikasi.
FRONTEND_URL=http://localhost:5173
# Opsional; digunakan sebagai fallback bila FRONTEND_URL tidak diisi.
APP_URL=http://localhost:5173
# Path cookie sesi. Gunakan / kecuali aplikasi dipasang pada sub-path.
SESSION_COOKIE_PATH=/

# ----------------------------------------------------------------------------
# DATABASE POSTGRESQL — seluruh nilai bertanda WAJIB harus diisi
# ----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trackit
DB_USER=postgres
DB_PASSWORD=
# Set true bila koneksi PostgreSQL memakai TLS.
DB_SSL=false
# Untuk DB_SSL=true, pertahankan true kecuali sertifikat memang dikelola sendiri.
DB_SSL_REJECT_UNAUTHORIZED=true

# ----------------------------------------------------------------------------
# KEAMANAN APLIKASI
# ----------------------------------------------------------------------------
# WAJIB: string acak minimal 32 karakter. Buat nilai baru untuk setiap environment.
JWT_SECRET=
# 10–14 (default 12). Nilai lebih tinggi memperlambat login namun lebih kuat.
PASSWORD_BCRYPT_ROUNDS=12
# 300–3600 detik (default 900 / 15 menit).
ACCESS_TOKEN_TTL_SECONDS=900
# false pada development/production. true hanya untuk environment test terisolasi.
ENABLE_DB_RESET=false
# OPSIONAL dan HANYA untuk dev/test. Jangan isi di production; user baru aktivasi via OTP.
DEFAULT_USER_PASSWORD=

# ----------------------------------------------------------------------------
# AKUN SUPERADMIN AWAL / SETELAH RESET DATABASE
# ----------------------------------------------------------------------------
# WAJIB bila ENABLE_DB_RESET=true. Nilai ini hanya dibaca backend untuk
# membuat satu akun superadmin setelah reset; jangan gunakan password lama
# atau kredensial yang sama antar environment.
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# JARINGAN, CORS, DAN PEMBATASAN AKSES
# ----------------------------------------------------------------------------
# Origin harus exact dan dipisahkan koma; wildcard (*) tidak didukung.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Kosongkan bila aplikasi tidak berada di belakang reverse proxy.
# Jika memakai proxy, isi IP/CIDR proxy yang tepercaya, dipisahkan koma.
TRUST_PROXY_CIDRS=
# Semua nilai berikut opsional; nilai default dipakai bila dikosongkan.
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=150
AUTH_RATE_LIMIT_MAX=20
EXPORT_RATE_LIMIT_MAX=10

# ----------------------------------------------------------------------------
# EMAIL SMTP — WAJIB lengkap agar OTP dan notifikasi email dapat dikirim
# ----------------------------------------------------------------------------
# Set true hanya setelah SMTP_HOST, SMTP_USER, dan SMTP_PASS sudah valid.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Port 587 = false (STARTTLS); port 465 = true (TLS langsung).
SMTP_SECURE=false
# Gmail: gunakan alamat pengirim dan App Password 16 karakter, bukan password akun.
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="People Technology <noreply@example.com>"

# ----------------------------------------------------------------------------
# BACKUP DATABASE (opsional; dipakai endpoint admin backup/restore)
# ----------------------------------------------------------------------------
DB_BACKUP_DIR=storage/backups
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_MAX_FILES=20
# Isi path penuh jika binary PostgreSQL tidak tersedia pada PATH sistem.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PSQL_PATH=psql

# ----------------------------------------------------------------------------
# MIGRASI DATABASE — proteksi target dan otorisasi perubahan
# ----------------------------------------------------------------------------
# fresh untuk database kosong, existing untuk database yang sudah ada.
MIGRATION_MODE=fresh
# Harus persis sama dengan target database untuk mencegah migrasi salah target.
MIGRATION_EXPECTED_HOST=localhost
MIGRATION_EXPECTED_DATABASE=trackit
# Tetap false secara normal. Set true hanya saat menjalankan migrasi terotorisasi.
ALLOW_DB_MIGRATIONS=false
# WAJIB sebelum menerapkan migrasi: ID bukti backup/restore yang sudah diverifikasi.
MIGRATION_RECOVERY_PROOF_ID=
# WAJIB pada production saat menerapkan migrasi, misalnya CR-TRACKIT-2026-001.
MIGRATION_CHANGE_ID=
# true pada production untuk memastikan owner DB bukan superuser PostgreSQL.
REQUIRE_NON_SUPERUSER=false

# ----------------------------------------------------------------------------
# TEST LIVE OPSIONAL — hanya untuk test yang sengaja menargetkan API eksternal
# ----------------------------------------------------------------------------
# TEST_API_URL=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
