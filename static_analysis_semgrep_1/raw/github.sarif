{"version":"2.1.0","runs":[{"invocations":[{"executionSuccessful":true,"toolExecutionNotifications":[]}],"results":[{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"C:\\Users\\Helmy\\Documents\\Magang\\Projects\\it-monitoring-assets\\.github\\workflows\\ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":34,"endLine":16,"snippet":{"text":"        uses: actions/checkout@v4"},"startColumn":9,"startLine":16}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"C:\\Users\\Helmy\\Documents\\Magang\\Projects\\it-monitoring-assets\\.github\\workflows\\ci.yml","uriBaseId":"%SRCROOT%"},"region":{"endColumn":36,"endLine":19,"snippet":{"text":"        uses: actions/setup-node@v4"},"startColumn":9,"startLine":19}}}],"message":{"text":"GitHub Actions step uses a mutable tag or branch reference. Tags and branch names can be silently repointed by the action owner, enabling supply-chain attacks — as seen in the trivy-action and kics-github-action compromises. Pin the reference to a full 40-character commit SHA instead, e.g. `uses: actions/checkout@8ade135a41bc03ea155e62e844d188df1ea18608`."},"properties":{},"ruleId":"yaml.github-actions.security.github-actions-mutable-action-tag.github-actions-mutable-action-tag"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"C:\\Users\\Helmy\\Documents\\Mag